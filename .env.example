# ──────────────────────────────────────────────────────────────────────
# FigureMatch — environment template.
# Copy this to `.env` and fill in OPENAI_API_KEY + JWT_SECRET.
# Everything else has a sane local default.
#
# Nothing is deployed today. In the May 2026 AWS deployment, secrets lived
# in AWS Secrets Manager and the rest was set on the App Runner service.
# ──────────────────────────────────────────────────────────────────────

# --- AI provider mode ---
# openai | mock (canned output, no key needed)
AI_PROVIDER_MODE=openai

# --- OpenAI (primary provider) ---
# Get a key at https://platform.openai.com/api-keys. Set a hard usage cap
# (we recommend $25/month) at https://platform.openai.com/account/limits
# to prevent runaway loops in dev.
OPENAI_API_KEY=sk-proj-REPLACE_ME
OPENAI_TEXT_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium     # low | medium | high
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# --- AWS (not needed for local dev) ---
# Used only to read the database credentials from Secrets Manager when
# RDS_SECRET_ARN is set. Nothing uploads to S3. Leave the keys blank.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Database (Postgres) ---
# Docker-compose service name `postgres` resolves from the backend container.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
# Compose-only overrides (the postgres image reads these on first boot):
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# When set, the backend fetches this Secrets Manager secret and rebuilds
# DATABASE_URL from it, as App Runner did in May 2026. Leave empty locally.
RDS_SECRET_ARN=

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_ME_with_openssl_rand_hex_32
JWT_ACCESS_TOKEN_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000  # 30 days
# Refresh cookie SameSite policy.
#   lax   — same-site only (local dev, or custom-domain prod)
#   none  — cross-site (e.g. *.amplifyapp.com → *.awsapprunner.com)
#   strict — most restrictive; breaks top-level navigation auth flows
COOKIE_SAMESITE=lax

# --- Storage ---
# Read by nothing: there is no S3 adapter, and images are stored on the
# backend's local disk.
S3_BUCKET_IMAGES=ai-content-images-dev
# The URL prefix of stored images. The backend serves them from disk at
# /local-images; in May 2026 this pointed at the App Runner service.
IMAGES_CDN_BASE_URL=http://localhost:8000/local-images

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Observability ---
# Backend Sentry DSN. Leave blank in dev; the SDK silently no-ops when
# this is empty. The frontend has no Sentry integration.
SENTRY_DSN=
LOG_LEVEL=INFO
